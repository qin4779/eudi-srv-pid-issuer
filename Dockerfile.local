FROM eclipse-temurin:17-jdk-jammy AS build

WORKDIR /workspace
COPY . .
RUN chmod +x gradlew && ./gradlew bootJar -x test --no-daemon

FROM eclipse-temurin:17-jre-jammy

WORKDIR /opt/forest-issuer
COPY --from=build /workspace/build/libs/pid-issuer-0.9.1.jar /opt/forest-issuer/pid-issuer.jar

# No keys in the image: a keystore generated here changed with every build, and
# wallets then rejected the newly signed metadata. The keystore is mounted from
# pid-issuer/config/keystore.jks instead (see docker-compose.yml).
ENTRYPOINT ["java", "-jar", "/opt/forest-issuer/pid-issuer.jar"]
